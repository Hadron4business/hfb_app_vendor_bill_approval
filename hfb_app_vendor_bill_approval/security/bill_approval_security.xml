<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_bill_approver" model="res.groups">
        <field name="name">Vendor Bill Approver</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="account.group_account_invoice" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_bill_approver'))]"/>
    </record>

    <record id="bill_approval_rule_own" model="ir.rule">
        <field name="name">Bill approval: own tasks</field>
        <field name="model_id" ref="model_bill_approval"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_bill_approver'))]"/>
    </record>

    <record id="bill_approval_rule_accounting" model="ir.rule">
        <field name="name">Bill approval: all tasks for accounting</field>
        <field name="model_id" ref="model_bill_approval"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="bill_approval_company_rule" model="ir.rule">
        <field name="name">Bill approval: multi-company</field>
        <field name="model_id" ref="model_bill_approval"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="bill_approval_rule_company_rule" model="ir.rule">
        <field name="name">Bill approval rule: multi-company</field>
        <field name="model_id" ref="model_bill_approval_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
