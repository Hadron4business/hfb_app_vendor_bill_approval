<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_bill_approval" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bill.approval</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_vendor_bills']" position="inside">
                <setting id="bill_approval" company_dependent="1"
                         help="Vendor bills need the approval of the people chosen by the approval rules before they can be posted">
                    <field name="bill_approval"/>
                    <div class="content-group" invisible="not bill_approval">
                        <div class="mt8">
                            <field name="bill_approval_auto" class="oe_inline"/>
                            <label for="bill_approval_auto" class="o_light_label"/>
                        </div>
                        <div class="mt8">
                            <button name="%(bill_approval_rule_action)d" icon="oi-arrow-right"
                                    type="action" string="Approval Rules" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
