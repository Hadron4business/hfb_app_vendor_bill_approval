<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bill_approval_wizard_view_form" model="ir.ui.view">
        <field name="name">bill.approval.wizard.form</field>
        <field name="model">bill.approval.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="mode" invisible="1"/>
                <field name="task_ids" invisible="1"/>
                <field name="move_id" invisible="1"/>
                <field name="description_required" invisible="1"/>
                <div invisible="mode != 'approve'">
                    <label for="description" string="What is this expense for?"/>
                    <span class="text-muted ms-1" invisible="not description_required">(required)</span>
                    <field name="description" placeholder="Purpose, project, who ordered it, was it delivered..."/>
                </div>
                <group invisible="mode != 'reject'">
                    <field name="reason" required="mode == 'reject'" placeholder="Why is the bill rejected?"/>
                </group>
                <group invisible="mode not in ('handover', 'add')">
                    <field name="user_id" required="mode in ('handover', 'add')" string="Approver"/>
                    <field name="note" placeholder="e.g. holidays, project manager"/>
                </group>
                <footer>
                    <button string="Approve" name="action_confirm" type="object" class="btn-primary"
                            invisible="mode != 'approve'" data-hotkey="q"/>
                    <button string="Reject" name="action_confirm" type="object" class="btn-danger"
                            invisible="mode != 'reject'" data-hotkey="q"/>
                    <button string="Hand Over" name="action_confirm" type="object" class="btn-primary"
                            invisible="mode != 'handover'" data-hotkey="q"/>
                    <button string="Ask for Approval" name="action_confirm" type="object" class="btn-primary"
                            invisible="mode != 'add'" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
